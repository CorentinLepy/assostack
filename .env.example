# Local development only. Never commit real credentials.
POSTGRES_DB=assostack
POSTGRES_USER=assostack
POSTGRES_PASSWORD=assostack-dev
DATABASE_URL=postgresql://assostack:assostack-dev@127.0.0.1:5432/assostack
PAYLOAD_SECRET=replace-me-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:4321

# Optional Astro organization-site build.
# When both values are empty, apps/web builds the generic AssoStack project landing page.
# Example values: http://localhost:3001 and demo-association.
# When both are set, Astro fetches published content at build time and the build fails if the API cannot be reached.
ASSOSTACK_API_URL=
ASSOSTACK_ORGANIZATION=

# Optional generic static-site synchronization webhook.
# Payload requests a rebuild after public Page/Post changes and website configuration changes.
# It sends a provider-neutral JSON contract; adapters may translate that contract to Cloudflare,
# GitHub Actions, Netlify, Vercel, or another deployment service.
ASSOSTACK_SITE_REBUILD_WEBHOOK_URL=
# Optional bearer token sent only in the Authorization header. Never commit a real token.
ASSOSTACK_SITE_REBUILD_WEBHOOK_TOKEN=
# Bounded between 250 and 30000 milliseconds. Default: 5000.
ASSOSTACK_SITE_REBUILD_TIMEOUT_MS=5000
