# Production example for AssoStack deployment.
# Copy this file to .env.production and replace every placeholder before deployment.
# Never commit real secrets or production credentials.

# Sensitive values
POSTGRES_DB=assostack
POSTGRES_USER=assostack
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://assostack:replace-with-a-strong-password@postgres:5432/assostack
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=https://admin.example.com
PUBLIC_WEB_URL=https://example.com
ASSOSTACK_API_URL=http://admin:3001
ASSOSTACK_ORGANIZATION=demo-association
# 127.0.0.1 binds ports on localhost only.
# This is NOT reachable by cloudflared when it runs on another machine.
# If cloudflared runs on another trusted LAN host, set this to the Debian VM LAN IP
# and restrict firewall access to that trusted origin host where practical.
ASSOSTACK_BIND_ADDRESS=127.0.0.1
PAYLOAD_DB_PUSH=false
ASSOSTACK_JOBS_AUTORUN=false

# Optional non-sensitive overrides
# Set these if a different public hostname or bind address is required.
# The host bind default is 127.0.0.1 for local-only exposure by default.
