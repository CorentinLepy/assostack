---
import type {
  PublicNavigationItem,
  PublicOrganization,
  PublicPageSummary,
} from '../../../../packages/contracts/src/public-content'
import { themeStyle } from '../lib/theme'
import '../styles/global.css'

interface Props {
  description?: string | null
  organization: PublicOrganization
  pages: PublicPageSummary[]
  title: string
}

const { description, organization, pages, title } = Astro.props
const automaticNavigation: PublicNavigationItem[] = pages
  .filter((page) => page.slug !== 'home')
  .map((page) => ({
    external: false,
    href: `/${page.slug}`,
    label: page.title,
    newTab: false,
  }))
const navigation =
  organization.website.navigationMode === 'manual'
    ? organization.navigation
    : automaticNavigation
const siteTitle = organization.identity.siteTitle
const documentTitle = title === siteTitle ? title : `${title} — ${siteTitle}`
const style = themeStyle(organization.theme)
---

<html lang={organization.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <title>{documentTitle}</title>
  </head>
  <body class="organization-site" style={style}>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/">
          {
            organization.identity.logo && (
              <img
                class="site-brand__logo"
                src={organization.identity.logo.url}
                alt={organization.identity.logo.alt}
                width={organization.identity.logo.width ?? undefined}
                height={organization.identity.logo.height ?? undefined}
              />
            )
          }
          <span class="site-brand__copy">
            <strong>{siteTitle}</strong>
            {organization.identity.tagline && <small>{organization.identity.tagline}</small>}
          </span>
        </a>
        {
          navigation.length > 0 && (
            <nav aria-label="Primary navigation">
              <ul class="site-nav">
                {navigation.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.newTab ? '_blank' : undefined}
                      rel={item.newTab ? 'noopener noreferrer' : undefined}
                    >
                      {item.label}
                      {item.external && <span class="sr-only"> (external)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <strong>{siteTitle}</strong>
        {
          organization.publicContact.email && (
            <a href={`mailto:${organization.publicContact.email}`}>
              {organization.publicContact.email}
            </a>
          )
        }
        {
          organization.publicContact.phone && (
            <a href={`tel:${organization.publicContact.phone}`}>{organization.publicContact.phone}</a>
          )
        }
      </div>
    </footer>
  </body>
</html>
