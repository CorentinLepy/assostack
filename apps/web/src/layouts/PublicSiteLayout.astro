---
import type {
  PublicMedia,
  PublicNavigationItem,
  PublicOrganization,
  PublicPageSummary,
} from '../../../../packages/contracts/src/public-content'
import { getAbsoluteMediaURL, getCanonicalURL } from '../lib/seo'
import { themeStyle } from '../lib/theme'
import '../styles/global.css'

interface Props {
  canonicalPath?: string
  contentType?: 'article' | 'website'
  description?: string | null
  image?: PublicMedia | null
  organization: PublicOrganization
  pages: PublicPageSummary[]
  publishedAt?: string | null
  title: string
  updatedAt?: string | null
}

const {
  canonicalPath = '/',
  contentType = 'website',
  description,
  image,
  organization,
  pages,
  publishedAt,
  title,
  updatedAt,
} = Astro.props
const automaticNavigation: PublicNavigationItem[] = pages
  .filter((page) => page.slug !== 'home')
  .map((page) => ({
    external: false,
    href: `/${page.slug}`,
    label: page.title,
    newTab: false,
  }))
const navigation =
  organization.website.navigationMode === 'manual'
    ? organization.navigation
    : automaticNavigation
const siteTitle = organization.identity.siteTitle
const documentTitle = title === siteTitle ? title : `${title} — ${siteTitle}`
const style = themeStyle(organization.theme)
const canonicalURL = getCanonicalURL(organization, canonicalPath)
const socialImageURL = getAbsoluteMediaURL(organization, image)
const openGraphLocale = organization.locale.replace('-', '_')
---

<html lang={organization.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} — News`} href="/news/rss.xml" />

    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:title" content={documentTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {image?.width && <meta property="og:image:width" content={String(image.width)} />}
    {image?.height && <meta property="og:image:height" content={String(image.height)} />}
    {image?.alt && <meta property="og:image:alt" content={image.alt} />}

    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={documentTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {image?.alt && <meta name="twitter:image:alt" content={image.alt} />}

    {contentType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {contentType === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <title>{documentTitle}</title>
  </head>
  <body class="organization-site" style={style}>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/">
          {
            organization.identity.logo && (
              <img
                class="site-brand__logo"
                src={organization.identity.logo.url}
                alt={organization.identity.logo.alt}
                width={organization.identity.logo.width ?? undefined}
                height={organization.identity.logo.height ?? undefined}
              />
            )
          }
          <span class="site-brand__copy">
            <strong>{siteTitle}</strong>
            {organization.identity.tagline && <small>{organization.identity.tagline}</small>}
          </span>
        </a>
        {
          navigation.length > 0 && (
            <nav aria-label="Primary navigation">
              <ul class="site-nav">
                {navigation.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.newTab ? '_blank' : undefined}
                      rel={item.newTab ? 'noopener noreferrer' : undefined}
                    >
                      {item.label}
                      {item.external && <span class="sr-only"> (external)</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <strong>{siteTitle}</strong>
        {
          organization.publicContact.email && (
            <a href={`mailto:${organization.publicContact.email}`}>
              {organization.publicContact.email}
            </a>
          )
        }
        {
          organization.publicContact.phone && (
            <a href={`tel:${organization.publicContact.phone}`}>{organization.publicContact.phone}</a>
          )
        }
      </div>
    </footer>
  </body>
</html>
