---
import type {
  PublicOrganization,
  PublicPageSummary,
} from '../../../../packages/contracts/src/public-content'
import '../styles/global.css'

interface Props {
  description?: string | null
  organization: PublicOrganization
  pages: PublicPageSummary[]
  title: string
}

const { description, organization, pages, title } = Astro.props
const navigation = pages.filter((page) => page.slug !== 'home')
const homeTitle = title === organization.name ? title : `${title} — ${organization.name}`
---

<html lang={organization.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <title>{homeTitle}</title>
  </head>
  <body class="organization-site">
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href="/">{organization.name}</a>
        {
          navigation.length > 0 && (
            <nav aria-label="Primary navigation">
              <ul class="site-nav">
                {navigation.map((page) => (
                  <li>
                    <a href={`/${page.slug}`}>{page.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <strong>{organization.name}</strong>
        {
          organization.publicContact.email && (
            <a href={`mailto:${organization.publicContact.email}`}>
              {organization.publicContact.email}
            </a>
          )
        }
        {
          organization.publicContact.phone && (
            <a href={`tel:${organization.publicContact.phone}`}>{organization.publicContact.phone}</a>
          )
        }
      </div>
    </footer>
  </body>
</html>
