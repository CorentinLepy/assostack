---
import type {
  PublicOrganization,
  PublicPageSummary,
} from '../../../../packages/contracts/src/public-content'
import PublicPageSections from '../components/PublicPageSections.astro'
import PublicRichText from '../components/PublicRichText.astro'
import PublicSiteLayout from '../layouts/PublicSiteLayout.astro'
import {
  getPublicOrganization,
  getPublicPage,
  isPublicContentConfigured,
  listPublicPages,
} from '../lib/public-content'

export async function getStaticPaths() {
  if (!isPublicContentConfigured()) {
    return []
  }

  const [organization, pages] = await Promise.all([getPublicOrganization(), listPublicPages()])

  return pages
    .filter((page) => page.slug !== 'home')
    .map((page) => ({
      params: {
        slug: page.slug,
      },
      props: {
        organization,
        pages,
      },
    }))
}

interface Props {
  organization: PublicOrganization
  pages: PublicPageSummary[]
}

const { organization, pages } = Astro.props
const slug = Astro.params.slug

if (!slug) {
  throw new Error('A page slug is required to render a public organization page.')
}

const page = await getPublicPage(slug)
const hasSections = page.sections.length > 0
---

<PublicSiteLayout
  organization={organization}
  pages={pages}
  title={page.meta.title ?? page.title}
  description={page.meta.description ?? page.summary}
>
  {
    hasSections ? (
      <PublicPageSections sections={page.sections} />
    ) : (
      <article class="content-page">
        <p class="eyebrow">{organization.name}</p>
        <h1>{page.title}</h1>
        {page.summary && <p class="lead">{page.summary}</p>}
        <PublicRichText content={page.content} />
      </article>
    )
  }
</PublicSiteLayout>
